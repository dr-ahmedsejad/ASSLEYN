# Copier en .env et renseigner. Ne jamais versionner le .env reel.
DJANGO_SECRET_KEY=changez-moi-par-une-valeur-aleatoire-de-50-caracteres
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite en developpement, PostgreSQL en production :
# DATABASE_URL=postgres://asleyn:motdepasse@localhost:5432/asleyn
DATABASE_URL=sqlite:///db.sqlite3

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=True
